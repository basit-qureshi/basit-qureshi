# Copy this file to .env and fill in your values.

# "mock" = simulated broker, runs anywhere, no real connection (safe for testing/demo).
# "mt5"  = real connection to Exness (or any MT5 broker) via MetaTrader5 terminal. Windows only.
BROKER_MODE=mock

# Required only when BROKER_MODE=mt5. Get these from your Exness MT5 terminal (File > Login).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial

# demo or real. This is a second safety layer on top of BROKER_MODE — real order placement
# additionally requires an explicit confirm flag on the /api/start call.
ACCOUNT_TYPE=demo

# Trading parameters
# IMPORTANT for BROKER_MODE=mt5: use the EXACT symbol name your broker/account
# lists in MT5's Market Watch, not necessarily the plain "XAUUSD"/"EURUSD". Many
# brokers (e.g. Exness Standard accounts) suffix symbols, e.g. "XAUUSDm". In MT5,
# click the "+" / search box under Market Watch and search "XAU" or "EUR" to
# find the exact name. Names are case-sensitive.
SYMBOL=XAUUSD
TIMEFRAME=M1
RISK_PERCENT=1.0
# Trade this exact lot size every time instead of sizing from RISK_PERCENT.
# 0 = size from risk (recommended: the dollars at risk then stay constant even
# when the stop distance changes). With a fixed lot the risk moves with the
# stop — on Gold 0.01 lots is about $1.00 per 100 points.
FIXED_LOT_SIZE=0
# On Gold (2-digit quotes) one point = 0.01, so 100/200 is a $1.00 stop against
# a $2.00 target — the 1:2 risk:reward the retest strategy is built around.
# If the broker's minimum stop distance forces a wider stop, the target is
# scaled with it so the ratio holds.
STOP_LOSS_PIPS=100
TAKE_PROFIT_PIPS=200
# Several scalps can be open at once. Total exposure is roughly this number
# times RISK_PERCENT — 3 trades at 1% each puts 3% of the balance at risk.
MAX_OPEN_TRADES=3
MAX_DAILY_LOSS_PERCENT=5.0
MAX_DAILY_TRADES=0
# Move the stop to entry once the trade is 1R (100 points) in profit, and then
# leave it alone. A tight trail raises win rate but lowers money: measured on
# simulated M1 gold, 60/30 closed winners at 108 points average and netted
# +27,600, while 100/0 let them reach the full 200 and netted +49,300.
BREAKEVEN_TRIGGER_PIPS=100
TRAILING_STOP_PIPS=0
# Close a trade as soon as it's up this many dollars, ignoring TP. 0 = off.
# This caps the win side while the stop stays put, so it worsens the effective
# risk:reward — breakeven/trailing above is the safer way to protect profit.
QUICK_PROFIT_USD=0
# How often the market is checked. On M1 scalping keep this low (5s) — at 30s
# the bot only looks twice per candle and misses setups that resolve quickly.
POLL_INTERVAL_SECONDS=5
# Close a trade open this long that hasn't hit SL or TP. 0 = let it run.
MAX_TRADE_MINUTES=15
# aggressive | balanced | conservative — how permissive the entry filters are.
SENSITIVITY=balanced
# Lower EMA periods = faster/more frequent signals (more trades, more noise too).
EMA_FAST_PERIOD=5
EMA_SLOW_PERIOD=13
# "momentum_scalp"   = trend + a strong push candle. Fires many times an hour —
#                      use this if you want constant activity.
# "retest_rejection" = M5 breakout, then M1 pullback to the broken level and a
#                      rejection candle off it. Selective: roughly 1-3 signals
#                      an hour, so expect long quiet stretches.
# "scalp_breakout"   = trend + breakout + volume confirmation, single timeframe
# "ema_rsi"          = classic EMA crossover with RSI filter (fewest trades)
STRATEGY=momentum_scalp

DATABASE_URL=sqlite:///./trading_bot.db

# Only take a signal when this timeframe's trend agrees with it. Counter-trend
# pushes are usually pullback noise and are what chops an account. On simulated
# M1 gold, M5 raised win rate from ~55% to ~65%. Empty = no filter.
TREND_FILTER_TIMEFRAME=M5
# Skip entries while the spread is wider than this many points. Spread is paid
# on every scalp and blows out during news/thin hours. 0 = trade regardless.
MAX_SPREAD_POINTS=45

# --- Basket (multi-entry) scalping -------------------------------------------
# Off by default. When on, the bot stops managing trades one at a time: it opens
# up to BASKET_MAX_ENTRIES positions in the same direction (a new one only once
# price has moved BASKET_ADD_GAP_POINTS against the previous entry) and closes
# them ALL as soon as their combined floating profit reaches BASKET_TARGET_USD.
#
# Understand the shape of this before turning it on. Averaging into a losing
# move wins small very often and then loses big once — the run of small wins is
# not evidence the method works, it is what this pattern looks like right up
# until the large loss. BASKET_MAX_LOSS_USD is the only cap on that loss, so
# set it to an amount you are willing to lose in a single event.
# Each leg also carries a wide broker-side stop as a backstop in case the bot
# stops running with positions open; the group limits are the real exit.
BASKET_MODE=false
BASKET_MAX_ENTRIES=5
BASKET_ADD_GAP_POINTS=50
BASKET_TARGET_USD=3.0
BASKET_MAX_LOSS_USD=15.0
