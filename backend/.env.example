# Copy this file to .env and fill in your values.

# "mock" = simulated broker, runs anywhere, no real connection (safe for testing).
# "mt5"  = real connection to Exness (or any MT5 broker) via the MetaTrader5
#          terminal. Windows only.
BROKER_MODE=mock

# Required only when BROKER_MODE=mt5. From your MT5 terminal (File > Login).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial

# demo or real. A second safety layer on top of BROKER_MODE - starting on a real
# account additionally requires an explicit confirm flag on /api/start.
ACCOUNT_TYPE=demo

# Use the EXACT symbol name your account lists in MT5's Market Watch. Many
# brokers suffix it, e.g. Exness Standard uses "XAUUSDm". Case-sensitive.
SYMBOL=XAUUSD
TIMEFRAME=M1

# RETIRED — see the Execution cadence section below. This no longer drives
# anything; PROTECTIVE_POLL_SECONDS and REPORTING_POLL_SECONDS replaced it.
POLL_INTERVAL_SECONDS=5

# --- Grid strategy ------------------------------------------------------------
# The bot places GRID_BUY_STOP_LEVELS buy stops above the market and
# GRID_SELL_STOP_LEVELS sell stops below it, every one at GRID_LOT_SIZE. As
# price moves, those stops become positions. The moment the COMBINED profit of
# all of them reaches GRID_BASKET_TAKE_PROFIT_USD, every position is closed and
# every remaining pending order cancelled, then a fresh grid is built at the new
# price. No single trade has to reach the target on its own.
#
# The lot is never scaled after a loss. Martingale is what turns a run of small
# losses into a blown account.
GRID_LOT_SIZE=0.01
GRID_BUY_STOP_LEVELS=10
GRID_SELL_STOP_LEVELS=10
# A fresh grid is never placed on the M1 candle the bot became ready on - not on
# Start, not after a basket closes, and not after the orders are deleted by hand
# in MT5. It waits for the broker to confirm a strictly later candle, and if
# candle data cannot be read it places nothing at all rather than guessing.
#
# Spacing between levels, in price. 0.30 on gold is 30 points.
GRID_DISTANCE=0.30
GRID_BASKET_TAKE_PROFIT_USD=10.00
# Stop trading for the rest of the broker day once this much NET REALIZED profit
# has been booked - settled trades after their losses, commission and swap.
# Never floating profit, never equity movement, and only this bot's own trades
# (its symbol, mode and magic number), so a manual order or a connectivity test
# order cannot move it. The lock is worked out from those settled trades rather
# than remembered in memory, so restarting the backend or pressing Start again
# does not get past it. 0 = off, and it is off by default on purpose: the amount
# is your decision.
GRID_DAILY_PROFIT_TARGET_USD=0.00

# --- Risk -------------------------------------------------------------------
# Read this before running it with money.
#
# There is no stop loss on an individual grid trade, so a basket that never
# reaches its target simply keeps growing while price runs. At 0.01 lots a
# fully triggered 10+10 grid is 0.20 lots, and on gold that is $20 of profit or
# loss for every $1 the price moves.
#
# There is also a dead end built into a two-sided grid. Once both sides have
# filled, the buys and sells net to zero, the price terms cancel, and the
# basket's profit STOPS RESPONDING TO PRICE. It freezes at the sum of the sell
# entries minus the buy entries, less the spread paid to open them - and since
# the buys filled above the reference and the sells below it, that frozen
# number is always a loss. A full 10+10 grid at 0.30 spacing locks in about
# -$37.80, and no price in either direction ever recovers it. The take profit
# cannot be reached from there by any means.
#
# The settings below are therefore the entire risk model. If they do not end a
# basket, nothing will.
#
# The bot now REFUSES TO PLACE A NEW GRID when both GRID_BASKET_STOP_LOSS_USD
# and GRID_MAX_DAILY_LOSS_USD are 0. With both off there is nothing between a
# losing basket and the account, so that combination is treated as "not
# configured yet" rather than as permission to trade. Existing positions are
# still managed and still closed; only new entries are blocked, and the reason
# is shown on the dashboard.
# 0 = off.
GRID_BASKET_STOP_LOSS_USD=0.00
GRID_MAX_OPEN_POSITIONS=20
GRID_MAX_DAILY_LOSS_USD=100.00
GRID_MAX_EQUITY_DRAWDOWN_PERCENT=30.0

# Share of the balance a basket's worst case may never reach, in percent.
# Before placing a grid the bot prices the whole thing: the configured basket
# stop, and the structural -$37.80 a fully filled 10+10 grid locks in. If
# either one does not fit inside balance x (100 - reserve) / 100, no grid is
# placed and the dashboard says why. 50 means "never risk more than half the
# balance on one grid". Raising it makes the bot stricter, not looser.
GRID_CAPITAL_RESERVE_PERCENT=50.0

# A separate, persistent line under the account: no new grid is placed while
# the balance is at or below this. It is NOT the reserve above — the reserve is
# a share of the balance set aside for one proposed basket, the floor is the
# level the account must never be traded down past. 0 means you have not chosen
# one, and new entries stay blocked until you do.
GRID_CAPITAL_FLOOR_USD=0.00

# --- Execution cadence ------------------------------------------------------
# Seconds. How often the PROTECTIVE check runs: account, open positions,
# resting orders, valuation, and any unfinished close. It is independent of the
# M1 candle boundary and of the dashboard refresh. One cycle costs roughly
# 26 ms of in-process work against stated per-call delays, so 1.0 leaves the
# loop about 97% idle while still noticing a breach within a second of
# observing it. Lower it only with a measurement in hand.
PROTECTIVE_POLL_SECONDS=1.0

# Seconds. How often REPORTING runs: settlement, broker history, chart data and
# the websocket frame. Slower on purpose, and skipped rather than queued when
# protective work is waiting.
REPORTING_POLL_SECONDS=5.0

# Milliseconds. How long one broker call may be in flight before the bot
# reports itself BLOCKED and refuses new exposure. It never cancels the call
# and never sends a second one: a synchronous terminal call cannot be
# cancelled, and two live requests for one decision is worse than waiting.
BROKER_STALL_AFTER_MS=4000

# RETIRED. POLL_INTERVAL_SECONDS drove the single combined loop before the
# protective and reporting cadences above replaced it. It is still accepted so
# an existing settings file keeps loading, but it no longer changes anything —
# the dashboard reports it as retired rather than letting you set it and
# wonder why nothing happened. Use the two cadences above instead.

# Tags every order so the bot manages only its own, leaving manual trades and
# any other program alone.
GRID_MAGIC_NUMBER=990022
# Hours on the TIMEZONE clock below, NOT UTC. With TIMEZONE=Asia/Karachi,
# 17 and 22 means 5pm to 10pm Pakistan time. 0-24 means around the clock.
# Outside the window no new grid is placed; anything already open is still
# managed and still closed.
GRID_TRADING_START_HOUR=0
GRID_TRADING_END_HOUR=24

# Timezone for the dashboard's clock and for deciding which broker trading day a
# candle belongs to. Broker candle stamps arrive without a zone, so they are read
# as UTC and converted here. Set it to your broker's zone if the day should roll
# over at a different hour.
TIMEZONE=Asia/Karachi

DATABASE_URL=sqlite:///./trading_bot.db
