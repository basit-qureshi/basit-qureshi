# Copy this file to .env and fill in your values.

# "mock" = simulated broker, runs anywhere, no real connection (safe for testing/demo).
# "mt5"  = real connection to Exness (or any MT5 broker) via MetaTrader5 terminal. Windows only.
BROKER_MODE=mock

# Required only when BROKER_MODE=mt5. Get these from your Exness MT5 terminal (File > Login).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial

# demo or real. This is a second safety layer on top of BROKER_MODE — real order placement
# additionally requires an explicit confirm flag on the /api/start call.
ACCOUNT_TYPE=demo

# Trading parameters
# IMPORTANT for BROKER_MODE=mt5: use the EXACT symbol name your broker/account
# lists in MT5's Market Watch, not necessarily the plain "XAUUSD"/"EURUSD". Many
# brokers (e.g. Exness Standard accounts) suffix symbols, e.g. "XAUUSDm". In MT5,
# click the "+" / search box under Market Watch and search "XAU" or "EUR" to
# find the exact name. Names are case-sensitive.
SYMBOL=XAUUSD
TIMEFRAME=M1
RISK_PERCENT=1.0
STOP_LOSS_PIPS=20
TAKE_PROFIT_PIPS=40
MAX_OPEN_TRADES=1
MAX_DAILY_LOSS_PERCENT=5.0
MAX_DAILY_TRADES=0
BREAKEVEN_TRIGGER_PIPS=0
TRAILING_STOP_PIPS=0
POLL_INTERVAL_SECONDS=30
# Lower EMA periods = faster/more frequent signals (more trades, more noise too).
EMA_FAST_PERIOD=5
EMA_SLOW_PERIOD=13

DATABASE_URL=sqlite:///./trading_bot.db
